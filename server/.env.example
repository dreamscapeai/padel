# Wavespeed AI API key — get yours at https://wavespeed.ai/accesskey
WAVESPEED_API_KEY=your_wavespeed_api_key_here

# Full public URL of this server (required for Wavespeed to fetch uploaded reference images)
# e.g. https://virtual-tryon-api.onrender.com  OR  http://localhost:3000 for local dev
SERVER_URL=http://localhost:3000

# Port to listen on (Render sets this automatically)
PORT=3000
